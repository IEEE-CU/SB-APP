# Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB Connection (MongoDB Atlas)
# Replace username, password, and cluster-url with your actual values
MONGODB_URI=mongodb+srv://username:password@cluster-name.xxxxx.mongodb.net/ieee_finance?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=8h

# Google Gemini API (for AI insights)
GEMINI_API_KEY=your-gemini-api-key

# Cluster mode is NOT supported (Socket.IO rooms, presence and rate-limit counters are
# per process): the server refuses to start with ENABLE_CLUSTER=true. Leave it false/unset.
ENABLE_CLUSTER=false

# Trusted reverse proxies (controls req.ip, which keys the rate limiters and audit logs).
# 0 (or unset in development) = trust nothing: use this when clients connect directly.
# A hop count (1-10) or a list of proxy IPs/CIDRs (e.g. 10.0.0.0/8,loopback) = trust X-Forwarded-For
# only from those proxies. REQUIRED in production; "true" and "*" are rejected.
TRUST_PROXY=0

# Mongoose connection pool size (per worker process)
DB_MAX_POOL_SIZE=20
DB_MIN_POOL_SIZE=2

# Initial DB connection retry behavior (server stays up and /api/v1/health
# reports 503 if all retries are exhausted, rather than exiting the process)
DB_CONNECT_MAX_RETRIES=5
DB_CONNECT_RETRY_DELAY_MS=5000
